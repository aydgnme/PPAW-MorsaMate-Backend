						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"testuser\",\n    \"email\": \"user@example.com\",\n    \"password\": \"password123\",\n    \"fullName\": \"Test User\"\n}"
						},
						"url": {
