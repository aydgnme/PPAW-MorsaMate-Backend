				{
					"name": "Step 5: Get User Statistics",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Statistics retrieved successfully', function() {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('Statistics have correct structure', function() {",
									"    const response = pm.response.json();",
									"    pm.expect(response).to.have.property('totalPoints');",
									"    pm.expect(response).to.have.property('currentStreak');",
									"    pm.expect(response).to.have.property('longestStreak');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{jwt_token}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/users/me/statistics",
