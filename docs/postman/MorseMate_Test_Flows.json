				{
					"name": "Step 1: Health Check",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('API is healthy', function() {",
									"    pm.response.to.have.status(200);",
									"    const response = pm.response.json();",
									"    pm.expect(response.status).to.eql('UP');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/health",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"health"
							]
						}
					},
					"response": []
				},
				{
					"name": "Step 2: Register New User",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Registration successful', function() {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"pm.test('Response contains token and user', function() {",
									"    const response = pm.response.json();",
									"    pm.expect(response).to.have.property('token');",
									"    pm.expect(response).to.have.property('user');",
									"    ",
									"    // Save token and user_id",
									"    pm.environment.set('jwt_token', response.token);",
									"    pm.environment.set('user_id', response.user.id);",
									"    pm.environment.set('test_username', response.user.username);",
									"    ",
									"    console.log('Token saved:', response.token);",
									"    console.log('User ID saved:', response.user.id);",
									"});",
									"",
									"pm.test('User has correct initial values', function() {",
									"    const user = pm.response.json().user;",
									"    pm.expect(user.hearts).to.eql(5);",
									"    pm.expect(user.level).to.eql(1);",
									"    pm.expect(user.totalPoints).to.eql(0);",
									"    pm.expect(user.isActive).to.be.true;",
									"});"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"// Generate unique username and email",
									"const timestamp = Date.now();",
									"pm.environment.set('unique_username', 'user_' + timestamp);",
									"pm.environment.set('unique_email', 'user' + timestamp + '@test.com');"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"{{unique_username}}\",\n    \"email\": \"{{unique_email}}\",\n    \"password\": \"TestPass123\",\n    \"fullName\": \"Test User\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/register",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"auth",
								"register"
							]
						}
					},
					"response": []
				},
				{
					"name": "Step 3: Get Current User Profile",
