									"pm.test('Categories retrieved successfully', function() {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('Categories array returned', function() {",
									"    const response = pm.response.json();",
									"    pm.expect(response).to.be.an('array');",
									"    ",
									"    if (response.length > 0) {",
									"        pm.environment.set('category_id', response[0].id);",
									"        console.log('Category ID saved:', response[0].id);",
									"    }",
									"});",
									"",
									"pm.test('Categories are sorted by displayOrder', function() {",
									"    const categories = pm.response.json();",
									"    for (let i = 0; i < categories.length - 1; i++) {",
									"        pm.expect(categories[i].displayOrder).to.be.at.most(categories[i + 1].displayOrder);",
