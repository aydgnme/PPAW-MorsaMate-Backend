# Database Configuration
DB_URL=jdbc:postgresql://localhost:5432/morse_code_db
DB_USERNAME=your_username_here
DB_PASSWORD=your_password_here

# JWT Configuration (Generate a strong secret: https://randomkeygen.com/)
JWT_SECRET=change-this-to-a-secure-random-string-minimum-256-bits
JWT_EXPIRATION=86400000

# Stripe Configuration (Get from https://dashboard.stripe.com/apikeys)
STRIPE_API_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Application Configuration
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional: Email Configuration
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your_email@gmail.com
# MAIL_PASSWORD=your_app_password