		{
			"name": "Lessons - Public Endpoints",
			"item": [
				{
					"name": "Get Lesson by ID",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Response has lesson data\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('id');",
									"    pm.expect(jsonData).to.have.property('title');",
									"    pm.expect(jsonData).to.have.property('categoryId');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/v1/lessons/{{lesson_id}}",
							"host": ["{{base_url}}"],
							"path": ["v1", "lessons", "{{lesson_id}}"]
						},
						"description": "Retrieve a single lesson by ID (no authentication required)"
					},
					"response": []
				},
				{
					"name": "Get Lesson with Exercises",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Response includes exercises\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('exercises');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/v1/lessons/{{lesson_id}}?includeExercises=true",
							"host": ["{{base_url}}"],
							"path": ["v1", "lessons", "{{lesson_id}}"],
							"query": [
								{
									"key": "includeExercises",
									"value": "true"
								}
							]
						},
						"description": "Retrieve a lesson with all its exercises"
					},
					"response": []
				},
				{
					"name": "Get Lessons by Category",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Response is array\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.be.an('array');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/v1/lessons?categoryId={{category_id}}",
							"host": ["{{base_url}}"],
							"path": ["v1", "lessons"],
							"query": [
								{
									"key": "categoryId",
									"value": "{{category_id}}"
								}
							]
						},
						"description": "Get all lessons for a specific category, ordered by orderIndex"
					},
					"response": []
				},
				{
					"name": "Search Lessons by Title",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Response has pagination\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('content');",
									"    pm.expect(jsonData).to.have.property('totalElements');",
									"    pm.expect(jsonData).to.have.property('totalPages');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/v1/lessons/search?title=morse&page=0&size=20",
							"host": ["{{base_url}}"],
							"path": ["v1", "lessons", "search"],
							"query": [
								{
									"key": "title",
									"value": "morse"
								},
								{
									"key": "page",
									"value": "0"
								},
								{
									"key": "size",
									"value": "20"
								}
							]
						},
						"description": "Search lessons by title with pagination"
					},
					"response": []
				},
				{
					"name": "Get Exercise Count",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Response is a number\", function () {",
									"    var count = pm.response.json();",
									"    pm.expect(count).to.be.a('number');",
									"});"
								],
								"type": "text/javascript"
							}
						}
